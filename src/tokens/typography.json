{
  "primitive": {
    "font-family": {
      "sans":  "Inter, system-ui, -apple-system, sans-serif"
    },

    "font-size": {
      "100":  "0.625rem",
      "200":  "0.75rem",
      "300":  "0.875rem",
      "400":  "1rem",
      "500":  "1.25rem",
      "600":  "1.5rem",
      "700":  "1.75rem",
      "800":  "2rem",
      "900":  "2.5rem",
      "1000": "3rem"
