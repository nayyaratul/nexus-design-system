<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Scale mirror hover: highlight mirror pairs
    document.querySelectorAll('.scale-mirror-cell').forEach(cell => {
      cell.addEventListener('mouseenter', () => {
        const step = cell.getAttribute('data-step');
        const mirror = cell.getAttribute('data-mirror');
        const block = cell.closest('.scale-mirror-block');
        if (!block) return;
        block.querySelectorAll('.scale-mirror-cell').forEach(c => {
          const s = c.getAttribute('data-step');
          if (s === step || s === mirror) {
            c.classList.add('smc-highlight');
          } else {
            c.classList.add('smc-dim');
          }
        });
      });
      cell.addEventListener('mouseleave', () => {
        const block = cell.closest('.scale-mirror-block');
        if (!block) return;
        block.querySelectorAll('.scale-mirror-cell').forEach(c => {
          c.classList.remove('smc-highlight', 'smc-dim');
        });
      });
    });
  });
</script>
