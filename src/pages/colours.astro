    </div>
    <div class="badge-row">
      <div class="badge-cell b-aaa">AAA</div><div class="badge-cell b-aaa">AAA</div><div class="badge-cell b-aaa">AAA</div><div class="badge-cell b-aaa">AAA</div>
      <div class="badge-cell b-aa">AA</div><div class="badge-cell b-aalg">AA Lg</div><div class="badge-cell b-aalg">AA Lg</div>
      <div class="badge-cell b-fail">Fail</div><div class="badge-cell b-fail">Fail</div><div class="badge-cell b-fail">Fail</div><div class="badge-cell b-fail">Fail</div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       TEXT USABILITY — 14px button text
  ════════════════════════════════════════════════════════ -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">Button Text at 14px</span>
      <span class="section-desc">Which steps pass AA (≥ 4.5:1) for normal-weight 14px text on each theme background</span>
    </div>

    <div class="usability-grid">
      <!-- LIGHT THEME -->
      <div class="theme-panel light">
        <div class="theme-panel-head lh">Light theme — on #FFFFFF</div>

        <div class="text-sample-row">
          <div class="swatch-dot" style="background:#4B4B4A"></div>
          <div class="ts-meta">
            <div class="ts-label">Neutral Grey 70</div>
            <div class="ts-text" style="color:#4B4B4A">Button label text</div>
            <div class="ts-info">#4B4B4A · 8.73:1</div>
          </div>
          <span class="ts-badge aaa">AAA</span>
        </div>
        <div class="text-sample-row">
          <div class="swatch-dot" style="background:#5E5F5F"></div>
          <div class="ts-meta">
            <div class="ts-label">Neutral Grey 60</div>
            <div class="ts-text" style="color:#5E5F5F">Button label text</div>
            <div class="ts-info">#5E5F5F · 6.41:1</div>
          </div>
          <span class="ts-badge aa">AA</span>
        </div>
        <div class="text-sample-row">
          <div class="swatch-dot" style="background:#757575"></div>
