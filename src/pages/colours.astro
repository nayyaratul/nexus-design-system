      <div class="badge-cell b-aalg">AA Lg</div><div class="badge-cell b-aa">AA</div><div class="badge-cell b-aa">AA</div>
      <div class="badge-cell b-aaa">AAA</div><div class="badge-cell b-aaa">AAA</div><div class="badge-cell b-aaa">AAA</div><div class="badge-cell b-aaa">AAA</div>
    </div>
    <div class="badge-row">
      <div class="badge-cell b-aaa">AAA</div><div class="badge-cell b-aaa">AAA</div><div class="badge-cell b-aaa">AAA</div><div class="badge-cell b-aaa">AAA</div>
      <div class="badge-cell b-aa">AA</div><div class="badge-cell b-aalg">AA Lg</div><div class="badge-cell b-aalg">AA Lg</div>
      <div class="badge-cell b-fail">Fail</div><div class="badge-cell b-fail">Fail</div><div class="badge-cell b-fail">Fail</div><div class="badge-cell b-fail">Fail</div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       BLUE
  ════════════════════════════════════════════════════════ -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">Blue</span>
      <span class="section-desc">Hue 260 · Info · Links · Interactive elements</span>
    </div>
    <div class="scale">
      <div class="step on-light" style="background:#FAFCFF"><span class="n">0</span><span class="h">#FAFCFF</span></div>
      <div class="step on-light" style="background:#D1E0F6"><span class="n">10</span><span class="h">#D1E0F6</span></div>
      <div class="step on-light" style="background:#ABC4EE"><span class="n">20</span><span class="h">#ABC4EE</span></div>
      <div class="step on-light" style="background:#82ABF0"><span class="n">30</span><span class="h">#82ABF0</span></div>
      <div class="step on-dark"  style="background:#5692F6"><span class="n">40</span><span class="h">#5692F6</span></div>
      <div class="step on-dark"  style="background:#1C6EF1"><span class="n">50</span><span class="h">#1C6EF1</span></div>
      <div class="step on-dark"  style="background:#1459C7"><span class="n">60</span><span class="h">#1459C7</span></div>
      <div class="step on-dark"  style="background:#0C47A4"><span class="n">70</span><span class="h">#0C47A4</span></div>
      <div class="step on-dark"  style="background:#03337D"><span class="n">80</span><span class="h">#03337D</span></div>
