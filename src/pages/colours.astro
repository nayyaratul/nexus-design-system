---
import Layout from '../layouts/Default.astro';

// WCAG 2.x contrast ratio — computed at build time
function hexToLuminance(hex: string): number {
  const h = hex.replace('#', '');
  const toLinear = (c: number) => c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
  const r = toLinear(parseInt(h.substring(0, 2), 16) / 255);
  const g = toLinear(parseInt(h.substring(2, 4), 16) / 255);
  const b = toLinear(parseInt(h.substring(4, 6), 16) / 255);
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}

function contrastRatio(hex1: string, hex2: string): number {
  const l1 = hexToLuminance(hex1);
  const l2 = hexToLuminance(hex2);
  return Number(((Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05)).toFixed(2));
}

function wcagLevel(ratio: number): string {
  if (ratio >= 7) return 'aaa';
  if (ratio >= 4.5) return 'aa';
  if (ratio >= 3) return 'aalg';
  return 'fail';
}

const LIGHT_BG = '#FFFFFF';
const DARK_BG  = '#080808';
const levelLabels: Record<string, string> = { aaa: 'AAA', aa: 'AA', aalg: 'AA Lg', fail: 'Fail' };

function buildScale(name: string, desc: string, hexes: string[]) {
  return {
    name,
    desc,
    steps: hexes.map((hex, i) => {
      const step = i * 10;
      const onWhite = contrastRatio(hex, LIGHT_BG);
      const onDark  = contrastRatio(hex, DARK_BG);
      return {
        step,
        hex,
        txt: step <= 30 ? 'on-light' : 'on-dark',
        onWhite: { ratio: onWhite, level: wcagLevel(onWhite) },
        onDark:  { ratio: onDark,  level: wcagLevel(onDark) },
      };
    }),
  };
}

const scales = [
  buildScale('Neutral Grey', 'Pure neutral · Hue 0, Chroma 0 · Base UI surfaces & text', [
    '#FAFAFA', '#DEDEDE', '#C3C3C3', '#A8A8A8', '#8E8E8E',
    '#757575', '#5E5F5F', '#4B4B4A', '#373737', '#242424', '#080808',
  ]),
  buildScale('Cool Grey', 'Blue undertone · Hue 260, Chroma peak 0.030 · Panels & sidebars', [
    '#F8FAFD', '#DCDEE1', '#BFC3CA', '#A2A9B4', '#868F9F',
    '#6C7688', '#565F6F', '#444B57', '#32373E', '#212427', '#070809',
  ]),
  buildScale('Warm Grey', 'Stone undertone · Hue 55, Chroma peak 0.010 · Cards & content areas', [
    '#FBFAF9', '#DFDEDD', '#C5C2C1', '#ACA8A5', '#938D8A',
    '#7B7470', '#635D5A', '#4E4A47', '#393634', '#252322', '#080807',
  ]),
  buildScale('Red', 'Hue 25 · Error · Destructive actions · Alerts', [
    '#FBFBFB', '#FBD6D3', '#F8B1AB', '#F68D85', '#FC5C59',
    '#E32631', '#BC1624', '#971A1F', '#700F14', '#490D0E', '#140706',
  ]),
  buildScale('Green', 'Hue 152 · Success · Confirmations · Positive actions', [
    '#F4FEF6', '#C8E6CE', '#97D0A5', '#4EBF75', '#24A95B',
    '#198647', '#136D39', '#0B582C', '#02401E', '#002A10', '#030D05',
  ]),
  buildScale('Yellow', 'Hue 85 · Warning · Caution · Attention', [
    '#FFFCF4', '#F5DCAA', '#EEBD4B', '#D3A330', '#B78D27',
    '#93711D', '#775A14', '#62490D', '#483403', '#312200', '#0F0901',
  ]),
  buildScale('Blue', 'Hue 260 · Info · Links · Interactive elements', [
    '#FAFCFF', '#D1E0F6', '#ABC4EE', '#82ABF0', '#5692F6',
    '#1C6EF1', '#1459C7', '#0C47A4', '#03337D', '#001F5C', '#050B15',
  ]),
];

// Button Text at 14px — curated samples per theme (data-driven from scales)
const buttonTextSamples = {
  light: [
    { scaleName: 'Neutral Grey', step: 70 }, { scaleName: 'Neutral Grey', step: 60 }, { scaleName: 'Neutral Grey', step: 50 },
    { scaleName: 'Red', step: 60 }, { scaleName: 'Red', step: 50 },
    { scaleName: 'Green', step: 60 }, { scaleName: 'Green', step: 50 },
    { scaleName: 'Yellow', step: 70 }, { scaleName: 'Yellow', step: 60 }, { scaleName: 'Yellow', step: 50 },
    { scaleName: 'Blue', step: 60 }, { scaleName: 'Blue', step: 50, labelSuffix: ' — links' },
  ],
  dark: [
    { scaleName: 'Neutral Grey', step: 30 }, { scaleName: 'Neutral Grey', step: 40 }, { scaleName: 'Neutral Grey', step: 50 },
    { scaleName: 'Red', step: 40 }, { scaleName: 'Red', step: 50 },
    { scaleName: 'Green', step: 40 }, { scaleName: 'Green', step: 50 },
    { scaleName: 'Yellow', step: 40 }, { scaleName: 'Yellow', step: 30 },
    { scaleName: 'Blue', step: 40 }, { scaleName: 'Blue', step: 50, labelSuffix: ' — links' },
  ],
};

function getButtonTextRow(scaleName: string, step: number, theme: 'light' | 'dark') {
  const scale = scales.find((s) => s.name === scaleName);
  if (!scale) return null;
  const stepData = scale.steps.find((s) => s.step === step);
  if (!stepData) return null;
  const metric = theme === 'light' ? stepData.onWhite : stepData.onDark;
  return {
    label: `${scaleName} ${step}`,
    hex: stepData.hex,
    ratio: metric.ratio,
    level: metric.level,
    isMarginal: metric.level === 'aalg',
  };
}
---

<Layout title="Colours" section="colours">

  <h1 class="page-title">Colours</h1>
  <p class="page-sub">7 scales · 11 steps each · OKLCH-based · WCAG verified · Dark / Light symmetric</p>

  <!-- ─── LEGEND ─────────────────────────────────── -->
  <div class="legend">
    <span class="legend-item"><span class="legend-dot" style="background:#D6F0E0;border:1px solid #afd8be"></span>AAA ≥ 7:1 — all text</span>
    <span class="legend-item"><span class="legend-dot" style="background:#D6EAFF;border:1px solid #a8cff0"></span>AA ≥ 4.5:1 — normal text ≥14px</span>
    <span class="legend-item"><span class="legend-dot" style="background:#FFF0D6;border:1px solid #f0d49a"></span>AA Lg ≥ 3:1 — large / bold text only</span>
    <span class="legend-item"><span class="legend-dot" style="background:#EDE9E3;border:1px solid #ccc7bf"></span>Fail — decorative only</span>
    <span class="legend-item" style="margin-left:auto; font-style:italic; color: var(--ink-3)">Hover swatches & badges for details</span>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       COLOUR SCALES (data-driven)
  ════════════════════════════════════════════════════════ -->
  {scales.map((scale) => (
    <div class="section">
      <div class="section-header">
        <span class="section-title">{scale.name}</span>
        <span class="section-desc">{scale.desc}</span>
      </div>
      <div class="scale">
        {scale.steps.map((s) => (
          <div class={`step ${s.txt}`} style={`background:${s.hex}`}>
            <span class="n">{s.step}</span>
            <span class="h">{s.hex}</span>
          </div>
        ))}
      </div>
      <div class="badge-row">
        {scale.steps.map((s) => (
          <div class={`badge-cell b-${s.onWhite.level}`} data-ratio={`${s.onWhite.ratio}:1`}>
            {levelLabels[s.onWhite.level]}
          </div>
        ))}
      </div>
      <div class="badge-row">
        {scale.steps.map((s) => (
          <div class={`badge-cell b-${s.onDark.level}`} data-ratio={`${s.onDark.ratio}:1`}>
            {levelLabels[s.onDark.level]}
          </div>
        ))}
      </div>
    </div>
  ))}

  <!-- ═══════════════════════════════════════════════════════
       TEXT USABILITY — 14px button text
  ════════════════════════════════════════════════════════ -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">Button Text at 14px</span>
      <span class="section-desc">Which steps pass AA (≥ 4.5:1) for normal-weight 14px text on each theme background</span>
    </div>

    <div class="usability-grid">
      <div class="theme-panel light">
        <div class="theme-panel-head lh">Light theme — on #FFFFFF</div>
        {buttonTextSamples.light.map((sample) => {
          const row = getButtonTextRow(sample.scaleName, sample.step, 'light');
          if (!row) return null;
          const label = `${row.label}${sample.labelSuffix ?? ''}`;
          return (
            <div class="text-sample-row">
              <div class="swatch-dot" style={`background:${row.hex}`}></div>
              <div class="ts-meta">
                <div class="ts-label">{label}</div>
                <div class="ts-text" style={`color:${row.hex}`}>Button label text</div>
                <div class="ts-info">{row.hex} · {Number(row.ratio).toFixed(2)}:1{row.isMarginal ? ' ⚠' : ''}</div>
              </div>
              <span class={`ts-badge ${row.level}`}>{levelLabels[row.level]}</span>
            </div>
          );
        })}
      </div>

      <div class="theme-panel dark">
        <div class="theme-panel-head dh">Dark theme — on #080808</div>
        {buttonTextSamples.dark.map((sample) => {
          const row = getButtonTextRow(sample.scaleName, sample.step, 'dark');
          if (!row) return null;
          const label = `${row.label}${sample.labelSuffix ?? ''}`;
          return (
            <div class="text-sample-row">
              <div class="swatch-dot" style={`background:${row.hex};border-color:rgba(255,255,255,0.08)`}></div>
              <div class="ts-meta">
                <div class="ts-label" style="color:#9A9A9A">{label}</div>
                <div class="ts-text" style={`color:${row.hex}`}>Button label text</div>
                <div class="ts-info" style="color:#8E8E8E">{row.hex} · {Number(row.ratio).toFixed(2)}:1{row.isMarginal ? ' ⚠' : ''}</div>
              </div>
              <span class={`ts-badge ${row.level}`}>{levelLabels[row.level]}</span>
            </div>
          );
        })}
      </div>
    </div>

    <div class="info-box">
      <strong>Rule for 14px button text (normal weight):</strong>
      AA requires ≥ 4.5:1. For each scale, the minimum step that passes on white is <strong>Step 50</strong>. On dark (#080808), it's <strong>Step 40</strong> for chromatic scales and <strong>Step 40–50</strong> for greys.
      Steps marked ⚠ clear 4.5:1 only marginally — prefer one step darker (higher step number on white; lower on dark) for robust compliance across display variability.
      <br><br>
      <strong>Yellow exception:</strong> Yellow 20–30 appear bright but sit at low contrast on white. Always use Yellow 50+ for text on white. Yellow is best used as a background tint with dark (Step 70+) text on top.
    </div>
  </div>

  <div class="footer">
    Nexus Design System · Colours
  </div>

  <div class="colour-toast" id="colour-toast">Copied!</div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const steps = document.querySelectorAll('.step');
    const toast = document.getElementById('colour-toast');
    let hideTimer: ReturnType<typeof setTimeout>;

    steps.forEach(step => {
      step.addEventListener('click', () => {
        const hexEl = step.querySelector('.h');
        if (!hexEl) return;
        const hex = hexEl.textContent?.trim();
        if (!hex) return;

        navigator.clipboard.writeText(hex).then(() => {
          if (toast) {
            toast.textContent = `Copied ${hex}`;
            toast.classList.add('colour-toast--visible');
            clearTimeout(hideTimer);
            hideTimer = setTimeout(() => {
              toast.classList.remove('colour-toast--visible');
            }, 1800);
          }
        });
      });
    });
  });
</script>
