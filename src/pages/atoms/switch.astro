---
import Layout from '../../layouts/Default.astro';
import { SwitchShowcase } from '../../components/atoms/SwitchShowcase';
---

<Layout title="Switch" section="atoms/switch">
  <h1 class="page-title">Switch</h1>
  <p class="page-sub">Radix toggle switch with on/off states, 3 sizes, and disabled state</p>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Showcase</span>
      <span class="section-desc">Interactive — click to toggle states</span>
    </div>
    <SwitchShowcase client:load />
  </div>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Anatomy</span>
    </div>
    <div class="atom-spec">
      <div class="atom-spec-row"><span class="atom-spec-label">Sizes</span><span>sm (28x16), md (36x20), lg (44x24)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Thumb</span><span>sm=12px, md=16px, lg=20px (2px inset)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">States</span><span>off, on, disabled</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Off track</span><span>--color-bg-secondary + border</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">On track</span><span>--color-action-primary</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Radix</span><span>@radix-ui/react-switch</span></div>
    </div>
  </div>

  <div class="footer">Nexus Design System · Switch Atom</div>
</Layout>

<style>
  .atom-spec {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .atom-spec-row {
    display: flex;
    padding: 10px 16px;
    font-size: 13px;
    border-bottom: 1px solid var(--rule);
  }
  .atom-spec-row:last-child { border-bottom: none; }
  .atom-spec-label {
    min-width: 120px;
    font-weight: 500;
    color: var(--ink-2);
    flex-shrink: 0;
  }
</style>
