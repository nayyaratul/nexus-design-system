---
import Layout from '../../layouts/Default.astro';
import { IconShowcase } from '../../components/atoms/IconShowcase';
---

<Layout title="Icon" section="atoms/icon">
  <h1 class="page-title">Icon</h1>
  <p class="page-sub">Lucide wrapper · 5 sizes · Colour props · Accessible</p>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Showcase</span>
      <span class="section-desc">Wraps 1,688 Lucide icons with consistent sizing</span>
    </div>
    <IconShowcase client:load />
  </div>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Anatomy</span>
    </div>
    <div class="atom-spec">
      <div class="atom-spec-row"><span class="atom-spec-label">Sizes</span><span>xs (12px), sm (16px), md (20px), lg (24px), xl (32px)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Colour</span><span>Inherits currentColor by default, override via color prop</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">A11y</span><span>aria-label makes it role="img", otherwise role="presentation"</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Radix</span><span>No — Lucide React icons</span></div>
    </div>
  </div>

  <div class="footer">Nexus Design System · Icon Atom</div>
</Layout>

<style>
  .atom-spec {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .atom-spec-row {
    display: flex;
    padding: 10px 16px;
    font-size: 13px;
    border-bottom: 1px solid var(--rule);
  }
  .atom-spec-row:last-child { border-bottom: none; }
  .atom-spec-label {
    min-width: 120px;
    font-weight: 500;
    color: var(--ink-2);
    flex-shrink: 0;
  }
</style>
