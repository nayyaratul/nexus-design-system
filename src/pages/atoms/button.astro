---
import Layout from '../../layouts/Default.astro';
import { ButtonShowcase } from '../../components/atoms/ButtonShowcase';
---

<Layout title="Button" section="atoms/button">
  <h1 class="page-title">Button</h1>
  <p class="page-sub">Primary · Secondary · Dash · Destructive · Ghost · Icon-only · 3 sizes · Loading · Icon slots</p>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Showcase</span>
      <span class="section-desc">Interactive — hover and click to test states</span>
    </div>
    <ButtonShowcase client:load />
  </div>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Anatomy</span>
    </div>
    <div class="atom-spec">
      <div class="atom-spec-row"><span class="atom-spec-label">Variants</span><span>primary, secondary, dash, destructive, ghost</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Sizes</span><span>sm (32px), md (40px), lg (48px), xl (56px)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Shape</span><span>default (radius-100), rounded (radius-200), pill (radius-full)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">States</span><span>default, hover, active, disabled, loading</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Icon slots</span><span>iconLeft, iconRight</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Icon-only</span><span>iconOnly prop — square button, equal padding per size</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Radius</span><span>per shape: default --radius-100, rounded --radius-200, pill --radius-full</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Font</span><span>--font-weight-medium, size per variant</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Radix</span><span>No — native button element</span></div>
    </div>
  </div>

  <div class="footer">Nexus Design System · Button Atom</div>
</Layout>

<style>
  .atom-spec {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .atom-spec-row {
    display: flex;
    padding: 10px 16px;
    font-size: 13px;
    border-bottom: 1px solid var(--rule);
  }
  .atom-spec-row:last-child { border-bottom: none; }
  .atom-spec-label {
    min-width: 120px;
    font-weight: 500;
    color: var(--ink-2);
    flex-shrink: 0;
  }
</style>
