---
import Layout from '../../layouts/Default.astro';
import { TextShowcase } from '../../components/atoms/TextShowcase';
---

<Layout title="Text" section="atoms/text">
  <h1 class="page-title">Text</h1>
  <p class="page-sub">Body · Body Large · Caption · Micro · Overline</p>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Showcase</span>
      <span class="section-desc">All text variants with weight overrides</span>
    </div>
    <TextShowcase client:load />
  </div>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Anatomy</span>
    </div>
    <div class="atom-spec">
      <div class="atom-spec-row"><span class="atom-spec-label">Variants</span><span>body (14px), bodyLg (16px), caption (12px), micro (10px), overline (10px uppercase)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Weights</span><span>regular (400), medium (500), semibold (600)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Colours</span><span>body: text-primary, caption/micro/overline: text-secondary/tertiary</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Props</span><span>variant, size, weight, color, align, truncate, as</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Radix</span><span>No — native p/span elements</span></div>
    </div>
  </div>

  <div class="footer">Nexus Design System · Text Atom</div>
</Layout>

<style>
  .atom-spec {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .atom-spec-row {
    display: flex;
    padding: 10px 16px;
    font-size: 13px;
    border-bottom: 1px solid var(--rule);
  }
  .atom-spec-row:last-child { border-bottom: none; }
  .atom-spec-label {
    min-width: 120px;
    font-weight: 500;
    color: var(--ink-2);
    flex-shrink: 0;
  }
</style>
