---
import Layout from '../../layouts/Default.astro';
import { ThumbnailShowcase } from '../../components/atoms/ThumbnailShowcase';
---

<Layout title="Thumbnail" section="atoms/thumbnail">
  <h1 class="page-title">Thumbnail</h1>
  <p class="page-sub">Square cropped image previews in four sizes with optional hover overlay</p>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Showcase</span>
      <span class="section-desc">Hover overlay thumbnails to see the expand icon</span>
    </div>
    <ThumbnailShowcase client:load />
  </div>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Anatomy</span>
    </div>
    <div class="atom-spec">
      <div class="atom-spec-row"><span class="atom-spec-label">Aspect Ratio</span><span>1:1 square, object-fit: cover crops the image</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Sizes</span><span>xs (32px), sm (48px), md (64px), lg (96px)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Overlay</span><span>Optional semi-transparent dark layer on hover with centered icon</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Overlay Icon</span><span>Default Lucide Expand, customisable via overlayIcon prop</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Error</span><span>Lucide ImageOff icon centred on tertiary background</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Border Radius</span><span>var(--radius-100)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Custom</span><span>No Radix dependency — native img element</span></div>
    </div>
  </div>

  <div class="footer">Nexus Design System · Thumbnail Atom</div>
</Layout>

<style>
  .atom-spec {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .atom-spec-row {
    display: flex;
    padding: 10px 16px;
    font-size: 13px;
    border-bottom: 1px solid var(--rule);
  }
  .atom-spec-row:last-child { border-bottom: none; }
  .atom-spec-label {
    min-width: 120px;
    font-weight: 500;
    color: var(--ink-2);
    flex-shrink: 0;
  }
</style>
