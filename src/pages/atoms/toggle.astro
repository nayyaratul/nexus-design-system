---
import Layout from '../../layouts/Default.astro';
import { ToggleShowcase } from '../../components/atoms/ToggleShowcase';
---

<Layout title="Toggle" section="atoms/toggle">
  <h1 class="page-title">Toggle</h1>
  <p class="page-sub">A two-state button that can be toggled on or off, built on Radix Toggle primitive</p>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Showcase</span>
      <span class="section-desc">Interactive toggle states, variants, and sizes</span>
    </div>
    <ToggleShowcase client:load />
  </div>

  <div class="section">
    <div class="section-header"><span class="section-title">Anatomy</span></div>
    <div class="atom-spec">
      <div class="atom-spec-row"><span class="atom-spec-label">Radix</span><span>@radix-ui/react-toggle</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Variants</span><span>default (transparent bg), outline (bordered)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Sizes</span><span>sm (32px), md (40px), lg (48px)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">States</span><span>off, on (data-state="on"), hover, disabled</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Focus</span><span>2px solid focus ring with 2px offset</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Content</span><span>Text, icon, or icon + text</span></div>
    </div>
  </div>

  <div class="footer">Nexus Design System · Toggle Atom</div>
</Layout>

<style>
  .atom-spec {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .atom-spec-row {
    display: flex;
    padding: 10px 16px;
    font-size: 13px;
    border-bottom: 1px solid var(--rule);
  }
  .atom-spec-row:last-child { border-bottom: none; }
  .atom-spec-label {
    min-width: 120px;
    font-weight: 500;
    color: var(--ink-2);
    flex-shrink: 0;
  }
</style>
