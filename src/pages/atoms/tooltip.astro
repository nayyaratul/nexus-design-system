---
import Layout from '../../layouts/Default.astro';
import { TooltipShowcase } from '../../components/atoms/TooltipShowcase';
---

<Layout title="Tooltip" section="atoms/tooltip">
  <h1 class="page-title">Tooltip</h1>
  <p class="page-sub">Radix tooltip with 4 placement options, auto-arrow, and smooth enter/exit animations</p>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Showcase</span>
      <span class="section-desc">Interactive — hover buttons to see tooltips</span>
    </div>
    <TooltipShowcase client:load />
  </div>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Anatomy</span>
    </div>
    <div class="atom-spec">
      <div class="atom-spec-row"><span class="atom-spec-label">Sides</span><span>top (default), right, bottom, left</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Offset</span><span>4px default gap from trigger</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Max width</span><span>240px with text wrapping</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Styling</span><span>Dark bg (#1A1816), white text, --radius-050</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Animation</span><span>Fade + translate (150ms ease-out)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Radix</span><span>@radix-ui/react-tooltip</span></div>
    </div>
  </div>

  <div class="footer">Nexus Design System · Tooltip Atom</div>
</Layout>

<style>
  .atom-spec {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .atom-spec-row {
    display: flex;
    padding: 10px 16px;
    font-size: 13px;
    border-bottom: 1px solid var(--rule);
  }
  .atom-spec-row:last-child { border-bottom: none; }
  .atom-spec-label {
    min-width: 120px;
    font-weight: 500;
    color: var(--ink-2);
    flex-shrink: 0;
  }
</style>
