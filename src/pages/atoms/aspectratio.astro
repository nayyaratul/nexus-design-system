---
import Layout from '../../layouts/Default.astro';
import { AspectRatioShowcase } from '../../components/atoms/AspectRatioShowcase';
---

<Layout title="AspectRatio" section="atoms/aspectratio">
  <h1 class="page-title">AspectRatio</h1>
  <p class="page-sub">Constrains any child content to a consistent width-to-height ratio</p>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Showcase</span>
      <span class="section-desc">Interactive — select a ratio to preview</span>
    </div>
    <AspectRatioShowcase client:load />
  </div>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Anatomy</span>
    </div>
    <div class="atom-spec">
      <div class="atom-spec-row"><span class="atom-spec-label">Primitive</span><span>@radix-ui/react-aspect-ratio</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Props</span><span>ratio (number, default 4/3), className, children</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Common ratios</span><span>1:1, 3:2, 4:3, 16:9, 21:9, 9:16</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Technique</span><span>padding-bottom trick via Radix — zero-height container, children absolutely positioned</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Overflow</span><span>Hidden, border-radius --radius-100</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Children</span><span>Any content — images, video, maps, placeholders, iframes</span></div>
    </div>
  </div>

  <div class="footer">Nexus Design System · AspectRatio Atom</div>
</Layout>

<style>
  .atom-spec {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .atom-spec-row {
    display: flex;
    padding: 10px 16px;
    font-size: 13px;
    border-bottom: 1px solid var(--rule);
  }
  .atom-spec-row:last-child { border-bottom: none; }
  .atom-spec-label {
    min-width: 120px;
    font-weight: 500;
    color: var(--ink-2);
    flex-shrink: 0;
  }
</style>
