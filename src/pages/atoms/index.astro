---
import Layout from '../../layouts/Default.astro';

const atoms = [
  { name: 'Accordion',      href: '/atoms/accordion',      icon: '≡', desc: 'Radix accordion with single/multiple modes, collapsible sections, and slide animations', status: 'ready' },
  { name: 'Alert',           href: '/atoms/alert',           icon: '△', desc: 'Contextual feedback with 4 semantic variants, auto-mapped icons, and dismiss', status: 'ready' },
  { name: 'AspectRatio',     href: '/atoms/aspectratio',     icon: '⬒', desc: 'Radix aspect ratio wrapper to constrain any content to a given ratio', status: 'ready' },
  { name: 'Avatar',          href: '/atoms/avatar',          icon: '◐', desc: 'User photo with initials fallback, online indicator, and 5 sizes', status: 'ready' },
  { name: 'Badge',           href: '/atoms/badge',           icon: '●', desc: 'Status pills, count badges, and dot indicators for 5 semantic states', status: 'ready' },
  { name: 'Button',          href: '/atoms/button',          icon: '▸', desc: 'Primary, secondary, destructive, ghost variants with loading states and icon slots', status: 'ready' },
  { name: 'Calendar',         href: '/atoms/calendar',         icon: '▦', desc: 'Date picker grid with keyboard navigation, locale support, and disabled ranges', status: 'ready' },
  { name: 'Checkbox',        href: '/atoms/checkbox',        icon: '☑', desc: 'Radix checkbox with checked, indeterminate, and 2 sizes', status: 'ready' },
  { name: 'Code',            href: '/atoms/code',            icon: '⌥', desc: 'Inline and block code display with monospace font and optional copy-to-clipboard', status: 'ready' },
  { name: 'Divider',         href: '/atoms/divider',         icon: '—', desc: 'Horizontal and vertical separators with solid/dashed/dotted variants and optional label', status: 'ready' },
  { name: 'FormField',       href: '/atoms/formfield',       icon: '☷', desc: 'Composition wrapper — Label + children + error/hint spacing', status: 'ready' },
  { name: 'Upload File',     href: '/atoms/fileinput',       icon: '📎', desc: 'Upload file primitive; accept, multiple, 3 sizes, error/disabled', status: 'ready' },
  { name: 'Heading',         href: '/atoms/heading',         icon: 'H', desc: 'h1–h6 mapped to typography tokens with truncation support', status: 'ready' },
  { name: 'Icon',            href: '/atoms/icon',            icon: '◈', desc: 'Lucide icon wrapper with 5 sizes, colour props, and a11y support', status: 'ready' },
  { name: 'Image',           href: '/atoms/image',           icon: '▣', desc: '4:3 aspect container with blur letterbox, skeleton loading, and error fallback', status: 'ready' },
  { name: 'Input',           href: '/atoms/input',           icon: '▭', desc: 'Native input with 5 types, 3 sizes, error and disabled states', status: 'ready' },
  { name: 'Label',           href: '/atoms/label',           icon: 'L', desc: 'Radix label with required asterisk, disabled state, and 2 sizes', status: 'ready' },
  { name: 'Link',            href: '/atoms/link',            icon: '⟶', desc: 'Semantic anchor with default and subtle variants, external detection, and disabled state', status: 'ready' },
  { name: 'Menu',            href: '/atoms/menu',            icon: '☰', desc: 'Vertical action list with keyboard nav, checkbox/radio roles, groups, and polymorphic items', status: 'ready' },
  { name: 'Overlay',        href: '/atoms/overlay',        icon: '▢', desc: 'Full-screen dimmed backdrop for modals and drawers, optional click-to-close', status: 'ready' },
  { name: 'Pagination',      href: '/atoms/pagination',      icon: '◁', desc: 'Page navigation with dynamic range computation, ellipsis, and keyboard support', status: 'ready' },
  { name: 'Popover',         href: '/atoms/popover',         icon: '▧', desc: 'Radix popover with 4 placements, close button, arrow, and slide-fade animations', status: 'ready' },
  { name: 'ProgressBar',     href: '/atoms/progressbar',     icon: '▬', desc: 'Radix progress bar with 3 sizes, 4 colour variants, and smooth fill', status: 'ready' },
  { name: 'RadioGroup',      href: '/atoms/radiogroup',      icon: '◉', desc: 'Radix radio group with vertical/horizontal layout', status: 'ready' },
  { name: 'RatingStar',      href: '/atoms/ratingstar',     icon: '★', desc: 'Single star (filled/empty/half) for Rating molecule; token-only styling', status: 'ready' },
  { name: 'Select',          href: '/atoms/select',          icon: '▾', desc: 'Radix select with grouped options, popper content, and 3 sizes', status: 'ready' },
  { name: 'Skeleton',        href: '/atoms/skeleton',        icon: '▧', desc: 'Animated placeholder shapes for loading states — lines, circles, cards', status: 'ready' },
  { name: 'Slider',          href: '/atoms/slider',          icon: '⊶', desc: 'Radix slider with single and range modes, two sizes, and optional value display', status: 'ready' },
  { name: 'Spinner',         href: '/atoms/spinner',         icon: '↻', desc: 'Spinning and dots loading indicators with semantic colour', status: 'ready' },
  { name: 'StoryProgress',   href: '/atoms/storyprogress',   icon: '▬', desc: 'Segmented progress for reels/stories with smooth fill transition; parent controls timing', status: 'ready' },
  { name: 'Steps',           href: '/atoms/steps',           icon: '⊳', desc: 'Sequential step indicators with auto-indexing, completion tracking, and two orientations', status: 'ready' },
  { name: 'Switch',          href: '/atoms/switch',          icon: '⊘', desc: 'Radix toggle switch with 3 sizes and on/off states', status: 'ready' },
  { name: 'Table',           href: '/atoms/table',           icon: '▦', desc: 'Compound table with sizes, striped/hoverable variants, sticky headers, and sort indicators', status: 'ready' },
  { name: 'Tabs',            href: '/atoms/tabs',            icon: '⊞', desc: 'Radix tabs with default, underline, and pills variants plus horizontal scroll', status: 'ready' },
  { name: 'Tag',             href: '/atoms/tag',             icon: '⊟', desc: 'Interactive pill tags with leading icons and dismissible behaviour', status: 'ready' },
  { name: 'Timer',           href: '/atoms/timer',           icon: '⏱', desc: 'Display-only time value (mm:ss or hh:mm:ss) for assessments and countdowns', status: 'ready' },
  { name: 'Text',            href: '/atoms/text',            icon: 'T', desc: 'Body, caption, micro, overline variants with weight overrides', status: 'ready' },
  { name: 'Textarea',        href: '/atoms/textarea',        icon: '▦', desc: 'Multi-line text input with resize control and 3 sizes', status: 'ready' },
  { name: 'Timeline',        href: '/atoms/timeline',        icon: '⊡', desc: 'Vertical and horizontal timelines with status markers and alternate layout', status: 'ready' },
  { name: 'Thumbnail',       href: '/atoms/thumbnail',       icon: '▪', desc: 'Square cropped image with 4 sizes, optional hover overlay, and expand icon', status: 'ready' },
  { name: 'Toast',           href: '/atoms/toast',           icon: '▤', desc: 'Radix toast notifications with slide-in animation and swipe-to-dismiss', status: 'ready' },
  { name: 'Toggle',          href: '/atoms/toggle',          icon: '⊡', desc: 'Radix toggle button with pressed/unpressed states, two variants, and three sizes', status: 'ready' },
  { name: 'ToggleGroup',     href: '/atoms/togglegroup',     icon: '⊞', desc: 'Radix toggle group with single/multi select, joined borders, and vertical layout', status: 'ready' },
  { name: 'Tooltip',         href: '/atoms/tooltip',         icon: '▵', desc: 'Radix tooltip with 4 placements, arrow, and fade animations', status: 'ready' },
  { name: 'VisuallyHidden',  href: '/atoms/visuallyhidden',  icon: '◻', desc: 'Screen-reader-only content wrapper with asChild support for accessible UIs', status: 'ready' },
];
---

<Layout title="Atoms" section="atoms">
  <h1 class="page-title">Atoms</h1>
  <p class="page-sub">The smallest reusable UI primitives — 44 atoms across 8 categories</p>

  <!-- Ready atoms -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">Phases 1–6 — All Atoms</span>
      <span class="section-desc">44 of 44 complete</span>
    </div>

    <div class="atom-grid">
      {atoms.map((atom) => (
        <a href={atom.href} class="atom-card">
          <div class="atom-card-icon">{atom.icon}</div>
          <div class="atom-card-body">
            <div class="atom-card-name">{atom.name}</div>
            <div class="atom-card-desc">{atom.desc}</div>
          </div>
          <span class="atom-card-status atom-card-status--ready">Ready</span>
        </a>
      ))}
    </div>
  </div>

  <div class="footer">Nexus Design System · Atoms</div>
</Layout>

<style>
  .atom-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 12px;
    margin-bottom: 16px;
  }

  .atom-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 18px;
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    transition: border-color 0.15s, box-shadow 0.15s;
    text-decoration: none;
    color: inherit;
  }

  .atom-card:hover {
    border-color: var(--ink-3);
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .atom-card-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--page-bg);
    border-radius: 8px;
    font-size: 16px;
    flex-shrink: 0;
    color: var(--ink-2);
  }

  .atom-card-body {
    flex: 1;
    min-width: 0;
  }

  .atom-card-name {
    font-weight: 500;
    font-size: 15px;
    margin-bottom: 4px;
  }

  .atom-card-desc {
    font-size: 12px;
    color: var(--ink-3);
    line-height: 1.4;
  }

  .atom-card-status {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 2px 8px;
    border-radius: 100px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .atom-card-status--ready {
    background: #C8E6CE;
    color: #136D39;
  }

  @media (max-width: 640px) {
    .atom-grid { grid-template-columns: 1fr; }
  }
</style>
