---
import Layout from '../../layouts/Default.astro';
import { SelectShowcase } from '../../components/atoms/SelectShowcase';
---

<Layout title="Select" section="atoms/select">
  <h1 class="page-title">Select</h1>
  <p class="page-sub">Radix select with trigger sizing, grouped options, error state, and popper content</p>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Showcase</span>
      <span class="section-desc">Interactive — click triggers to open dropdown</span>
    </div>
    <SelectShowcase client:load />
  </div>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Anatomy</span>
    </div>
    <div class="atom-spec">
      <div class="atom-spec-row"><span class="atom-spec-label">Exports</span><span>Select, SelectTrigger, SelectContent, SelectItem, SelectGroup, SelectLabel</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Trigger sizes</span><span>sm (32px), md (40px), lg (48px) — matches Input</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">States</span><span>default, hover, focus, open, error, disabled</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Icons</span><span>Lucide ChevronDown (trigger), Check (selected)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Content</span><span>position="popper", elevated bg, box-shadow</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Radix</span><span>@radix-ui/react-select</span></div>
    </div>
  </div>

  <div class="footer">Nexus Design System · Select Atom</div>
</Layout>

<style>
  .atom-spec {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .atom-spec-row {
    display: flex;
    padding: 10px 16px;
    font-size: 13px;
    border-bottom: 1px solid var(--rule);
  }
  .atom-spec-row:last-child { border-bottom: none; }
  .atom-spec-label {
    min-width: 120px;
    font-weight: 500;
    color: var(--ink-2);
    flex-shrink: 0;
  }
</style>
