---
import Layout from '../../layouts/Default.astro';
import { DividerShowcase } from '../../components/atoms/DividerShowcase';
---

<Layout title="Divider" section="atoms/divider">
  <h1 class="page-title">Divider</h1>
  <p class="page-sub">Semantic separator with solid, dashed, and dotted variants, optional label, and vertical orientation</p>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Showcase</span>
      <span class="section-desc">All orientations, variants, and spacing options</span>
    </div>
    <DividerShowcase client:load />
  </div>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Anatomy</span>
    </div>
    <div class="atom-spec">
      <div class="atom-spec-row"><span class="atom-spec-label">Orientation</span><span>horizontal (default), vertical</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Variants</span><span>solid, dashed, dotted</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Label</span><span>Optional text centered between two lines (horizontal only)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Spacing</span><span>sm (8px), md (16px), lg (24px)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Colour</span><span>--color-border-subtle</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Custom</span><span>No Radix dependency — semantic hr / div[role=separator]</span></div>
    </div>
  </div>

  <div class="footer">Nexus Design System · Divider Atom</div>
</Layout>

<style>
  .atom-spec {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .atom-spec-row {
    display: flex;
    padding: 10px 16px;
    font-size: 13px;
    border-bottom: 1px solid var(--rule);
  }
  .atom-spec-row:last-child { border-bottom: none; }
  .atom-spec-label {
    min-width: 120px;
    font-weight: 500;
    color: var(--ink-2);
    flex-shrink: 0;
  }
</style>
