---
import Layout from '../../layouts/Default.astro';
import { SpinnerShowcase } from '../../components/atoms/SpinnerShowcase';
---

<Layout title="Spinner" section="atoms/spinner">
  <h1 class="page-title">Spinner</h1>
  <p class="page-sub">Spin · Dots · 5 sizes · Accessible loading indicator</p>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Showcase</span>
      <span class="section-desc">Used inside buttons, content areas, and page transitions</span>
    </div>
    <SpinnerShowcase client:load />
  </div>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Anatomy</span>
    </div>
    <div class="atom-spec">
      <div class="atom-spec-row"><span class="atom-spec-label">Variants</span><span>spin (circular arc), dots (3-dot pulse)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Sizes</span><span>xs (14px), sm (18px), md (24px), lg (32px), xl (48px)</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Colour</span><span>Track: --color-border-subtle, Arc: --color-action-primary</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">A11y</span><span>role="status", aria-label="Loading"</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Radix</span><span>No — native SVG / span</span></div>
    </div>
  </div>

  <div class="footer">Nexus Design System · Spinner Atom</div>
</Layout>

<style>
  .atom-spec {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .atom-spec-row {
    display: flex;
    padding: 10px 16px;
    font-size: 13px;
    border-bottom: 1px solid var(--rule);
  }
  .atom-spec-row:last-child { border-bottom: none; }
  .atom-spec-label {
    min-width: 120px;
    font-weight: 500;
    color: var(--ink-2);
    flex-shrink: 0;
  }
</style>
