---
import Layout from '../../layouts/Default.astro';
import { FormFieldShowcase } from '../../components/atoms/FormFieldShowcase';
---

<Layout title="FormField" section="atoms/formfield">
  <h1 class="page-title">FormField</h1>
  <p class="page-sub">Composition wrapper — Label + children + error/hint with consistent spacing</p>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Showcase</span>
      <span class="section-desc">Composes Label with Input, Textarea, Select, and more</span>
    </div>
    <FormFieldShowcase client:load />
  </div>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Anatomy</span>
    </div>
    <div class="atom-spec">
      <div class="atom-spec-row"><span class="atom-spec-label">Structure</span><span>Label → children slot → error (role="alert") or hint</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Props</span><span>label, htmlFor, required, hint, error, disabled, children</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Spacing</span><span>--space-050 gap between elements</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Imports</span><span>Label atom internally</span></div>
      <div class="atom-spec-row"><span class="atom-spec-label">Radix</span><span>No — pure composition</span></div>
    </div>
  </div>

  <div class="footer">Nexus Design System · FormField Atom</div>
</Layout>

<style>
  .atom-spec {
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .atom-spec-row {
    display: flex;
    padding: 10px 16px;
    font-size: 13px;
    border-bottom: 1px solid var(--rule);
  }
  .atom-spec-row:last-child { border-bottom: none; }
  .atom-spec-label {
    min-width: 120px;
    font-weight: 500;
    color: var(--ink-2);
    flex-shrink: 0;
  }
</style>
