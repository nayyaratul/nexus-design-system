  /* ═══════════════════════════════════════════════════════════
     APP PREVIEW (MOBILE) — editorial stage + refined controls
  ══════════════════════════════════════════════════════════════ */
  .app-preview-section {
    margin-bottom: 56px;
  }

  .app-preview-stage {
    --app-preview-radius: 20px;
    --app-preview-padding: 28px;
    background: linear-gradient(165deg, color-mix(in srgb, var(--color-bg-primary) 98%, var(--grey-90)) 0%, color-mix(in srgb, var(--color-bg-secondary) 96%, var(--grey-80)) 100%);
    border-radius: var(--app-preview-radius);
    padding: var(--app-preview-padding);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-border-subtle) 60%, transparent),
