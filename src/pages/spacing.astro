---
import Layout from '../layouts/Default.astro';
import AccordionSection from '../components/AccordionSection.astro';

const primitiveScale = [
  { token: '025',  px: 2,  rem: '0.125',  use: 'Micro — hairline gaps, borders', pragmatic: false },
  { token: '050',  px: 4,  rem: '0.25',   use: 'Tight — icon gaps, compact padding', pragmatic: false },
  { token: '075',  px: 6,  rem: '0.375',  use: 'Pragmatic — legacy product patterns', pragmatic: true },
  { token: '100',  px: 8,  rem: '0.5',    use: 'Small — base unit', pragmatic: false },
  { token: '125',  px: 10, rem: '0.625',  use: 'Pragmatic — legacy product patterns', pragmatic: true },
  { token: '150',  px: 12, rem: '0.75',   use: 'Medium — card padding, list spacing', pragmatic: false },
  { token: '200',  px: 16, rem: '1',     use: 'Base — default padding', pragmatic: false },
  { token: '250',  px: 20, rem: '1.25',   use: 'Medium-large', pragmatic: false },
  { token: '300',  px: 24, rem: '1.5',    use: 'Large — section spacing', pragmatic: false },
  { token: '400',  px: 32, rem: '2',      use: 'X-large', pragmatic: false },
  { token: '500',  px: 40, rem: '2.5',    use: 'XX-large', pragmatic: false },
  { token: '600',  px: 48, rem: '3',      use: 'Section blocks', pragmatic: false },
  { token: '800',  px: 64, rem: '4',      use: 'Major sections', pragmatic: false },
  { token: '1000', px: 80, rem: '5',      use: 'Hero, large layouts', pragmatic: false },
];

const usageCategories = [
  { name: 'Small', range: '2–12px', tokens: 'space-025–150', use: 'Icon gaps, compact padding, badge padding, inline spacing', samplePx: [4, 8, 12] },
  { name: 'Medium', range: '16–24px', tokens: 'space-200–300', use: 'Card padding, list spacing, section spacing', samplePx: [16, 20, 24] },
  { name: 'Large', range: '32–80px', tokens: 'space-400–1000', use: 'Major sections, page padding, hero areas', samplePx: [32, 48, 64] },
];

const bootstrapMapping = [
  { bootstrap: '0', value: '0', px: '0px', token: null },
  { bootstrap: '1', value: '0.25rem', px: '4px', token: 'space-050' },
  { bootstrap: '2', value: '0.5rem', px: '8px', token: 'space-100' },
  { bootstrap: '3', value: '1rem', px: '16px', token: 'space-200' },
  { bootstrap: '4', value: '1.25rem', px: '20px', token: 'space-250' },
  { bootstrap: '5', value: '1.5rem', px: '24px', token: 'space-300' },
];

const cssExample = `margin: var(--space-200);
margin-bottom: var(--space-300);
padding: var(--space-150) var(--space-200);
gap: var(--space-100);`;

const scssExample = `@use 'base' as *;

.card {
  padding: var(--space-200);
  & + .card { margin-top: var(--space-150); }
}`;

const layoutPatterns = [
  { context: 'Card padding', values: '12px, 16px, 20px, 24px', tokens: 'space-150, space-200, space-250, space-300', mockup: 'card' },
  { context: 'Flex gap', values: '4px, 8px, 12px, 16px, 24px', tokens: 'space-050, space-100, space-150, space-200, space-300', mockup: 'flex' },
  { context: 'Button padding', values: '4px 8px, 8px 12px, 10px 16px', tokens: 'space-050/100, space-100/150, space-125/200', mockup: 'button' },
  { context: 'Modal padding', values: '20px, 24px', tokens: 'space-250, space-300', mockup: 'modal' },
  { context: 'Section spacing', values: '12px, 16px, 24px', tokens: 'space-150, space-200, space-300', mockup: 'section' },
  { context: 'Container padding', values: '16px (mobile), 24px (desktop)', tokens: 'space-200, space-300', mockup: 'container' },
];

const scalePreviewItems = [
  { token: '025', px: 2, pragmatic: false },
  { token: '050', px: 4, pragmatic: false },
  { token: '075', px: 6, pragmatic: true },
  { token: '100', px: 8, pragmatic: false },
  { token: '125', px: 10, pragmatic: true },
  { token: '150', px: 12, pragmatic: false },
  { token: '200', px: 16, pragmatic: false },
  { token: '300', px: 24, pragmatic: false },
  { token: '400', px: 32, pragmatic: false },
  { token: '600', px: 48, pragmatic: false },
  { token: '800', px: 64, pragmatic: false },
  { token: '1000', px: 80, pragmatic: false },
];
---

<Layout title="Spacing" section="spacing">
  <h1 class="page-title">Spacing</h1>
  <p class="page-sub">4px base grid · 2–80px scale · Margins · Padding · Gaps · REM units</p>

  <!-- ═══════════════════════════════════════════════════════
       OVERVIEW
  ════════════════════════════════════════════════════════ -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">Overview</span>
      <span class="section-desc">Consistent spacing for margins, padding, and gaps across the product</span>
    </div>

    <div class="info-box">
      <strong>Base unit:</strong> 4px. The scale follows a 4px grid where possible, with pragmatic exceptions at 6px and 10px for existing product patterns.
      <br /><br />
      <strong>Units:</strong> All tokens output in rem (root stays at 16px). This preserves accessibility and scales with user font-size preferences.
      <br /><br />
      <strong>Scope:</strong> Spacing covers margins, padding, and gaps between elements. Borders and dividers are documented separately.
    </div>

    <div class="space-grid-4px">
      {[...Array(64)].map((_, i) => (
        <div class="space-grid-cell"></div>
      ))}
    </div>
    <span class="grid-diagram-caption">4px base unit · all spacing aligns to this grid (except pragmatic tokens)</span>

    <div class="space-mpg-diagram">
      <div class="space-mpg-outer">
        <span class="space-mpg-label space-mpg-label--margin">margin</span>
        <div class="space-mpg-border">
          <span class="space-mpg-label space-mpg-label--border">border</span>
          <div class="space-mpg-inner">
            <span class="space-mpg-label space-mpg-label--padding">padding</span>
            <div class="space-mpg-content">
              <span class="space-mpg-label space-mpg-label--gap">gap</span>
              <div class="space-mpg-flex">
                <div></div><div></div><div></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <span class="grid-diagram-caption">Margin (outside) · Padding (inside) · Gap (between flex children)</span>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       PRIMITIVE SCALE
  ════════════════════════════════════════════════════════ -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">Primitive Scale</span>
      <span class="section-desc">Raw space tokens · 2–80px · Use for margins, padding, gap</span>
    </div>

    <div class="info-box space-info-box">
      Primitives are the raw value palette — they carry no usage opinion. Use them wherever you need consistent spacing.
      Tokens marked <span class="pragmatic-tag">pragmatic</span> (6px, 10px) are not on the 4px grid but are included for existing product patterns. Prefer grid-aligned tokens for new work.
    </div>

    <div class="type-table space-primitive-table">
      <div class="type-table-head">
        <span class="tt-col tt-token">Token</span>
        <span class="tt-col tt-px">px</span>
        <span class="tt-col tt-rem">rem</span>
        <span class="tt-col tt-use">Use</span>
        <span class="tt-col tt-preview">Preview</span>
      </div>
      {primitiveScale.map((s) => (
        <div class="type-table-row">
          <span class="tt-col tt-token"><code>--space-{s.token}</code></span>
          <span class="tt-col tt-px">{s.px}</span>
          <span class="tt-col tt-rem">{s.rem}</span>
          <span class="tt-col tt-use">{s.use}{s.pragmatic && ' (pragmatic)'}</span>
          <span class="tt-col tt-preview">
            <div class={`space-table-preview ${s.pragmatic ? 'space-table-preview--pragmatic' : ''}`} style={`gap: ${s.px}px`}>
              <div></div><div></div><div></div>
            </div>
          </span>
        </div>
      ))}
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       VISUAL SCALE
  ════════════════════════════════════════════════════════ -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">Scale Preview</span>
      <span class="section-desc">Visual comparison of spacing values</span>
    </div>

    <div class="space-scale-demo">
      {scalePreviewItems.map((item) => (
        <div class="space-scale-item" data-tooltip={`--space-${item.token} · ${item.px}px${item.pragmatic ? ' (pragmatic)' : ''}`}>
          <div class={`space-scale-blocks ${item.pragmatic ? 'space-scale-blocks--pragmatic' : ''}`} style={`gap: ${item.px}px`}>
            <div></div><div></div><div></div>
          </div>
          <span class="space-scale-label">--space-{item.token}</span>
          <span class="space-scale-label space-scale-label--px">{item.px}px</span>
        </div>
      ))}
    </div>
    <span class="grid-diagram-caption">Gap between blocks increases by token value · Hover for details</span>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       USAGE CATEGORIES
  ════════════════════════════════════════════════════════ -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">Usage Categories</span>
      <span class="section-desc">When to use each range</span>
    </div>

    <div class="space-categories">
      {usageCategories.map((cat) => (
        <div class="space-category-card">
          <div class="space-category-preview">
            {cat.samplePx.map((px) => (
              <div class="space-category-sample" style={`gap: ${px}px`}>
                <div></div><div></div><div></div>
              </div>
            ))}
          </div>
          <div class="space-category-name">{cat.name}</div>
          <div class="space-category-range">{cat.range}</div>
          <div class="space-category-tokens"><code>{cat.tokens}</code></div>
          <div class="space-category-use">{cat.use}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       BOOTSTRAP ALIGNMENT
  ════════════════════════════════════════════════════════ -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">Bootstrap Alignment</span>
      <span class="section-desc">How Bootstrap utilities map to our tokens</span>
    </div>

    <div class="info-box space-info-box">
      Our product uses Bootstrap 5 for layout. Bootstrap's <code>$spacer</code> is 1rem (16px). Utilities like <code>m-*</code>, <code>p-*</code>, <code>gap-*</code> use Bootstrap's scale. Use our tokens in component CSS; use Bootstrap utilities for grid and layout.
    </div>

    <div class="type-table">
      <div class="type-table-head">
        <span class="tt-col tt-token">Bootstrap</span>
        <span class="tt-col tt-px">Value</span>
        <span class="tt-col tt-rem">px</span>
        <span class="tt-col tt-use">Our token</span>
      </div>
      {bootstrapMapping.map((row) => (
        <div class="type-table-row">
          <span class="tt-col tt-token"><code>m-{row.bootstrap}</code> <code>p-{row.bootstrap}</code> <code>gap-{row.bootstrap}</code></span>
          <span class="tt-col tt-px">{row.value}</span>
          <span class="tt-col tt-rem">{row.px}</span>
          <span class="tt-col tt-use">
            {row.token && <code>{row.token}</code>}
            {!row.token && '—'}
          </span>
        </div>
      ))}
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       LAYOUT PATTERNS
  ════════════════════════════════════════════════════════ -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">Layout Patterns</span>
      <span class="section-desc">Common spacing by context</span>
    </div>

    <div class="space-patterns-list">
      {layoutPatterns.map((p) => (
        <div class="space-pattern-row">
          <div class="space-pattern-mockup">
            {p.mockup === 'card' && (
              <div class="space-mockup-card">
                <div class="space-mockup-inner" style="padding: 16px;">
                  <span class="layout-thumb-label">space-200</span>
                </div>
              </div>
            )}
            {p.mockup === 'flex' && (
              <div class="space-mockup-flex" style="gap: 8px;">
                <div></div><div></div><div></div>
              </div>
            )}
            {p.mockup === 'button' && (
              <div class="space-mockup-button" style="padding: 8px 12px;">
                <span class="layout-thumb-label">space-100/150</span>
              </div>
            )}
            {p.mockup === 'modal' && (
              <div class="space-mockup-modal">
                <div class="space-mockup-inner" style="padding: 24px;">
                  <span class="layout-thumb-label">space-300</span>
                </div>
              </div>
            )}
            {p.mockup === 'section' && (
              <div class="space-mockup-section">
                <div></div>
                <div class="space-mockup-gap" style="height: 24px;"></div>
                <div></div>
              </div>
            )}
            {p.mockup === 'container' && (
              <div class="space-mockup-container">
                <div class="space-mockup-inner" style="padding: 24px;">
                  <span class="layout-thumb-label">space-300</span>
                </div>
              </div>
            )}
          </div>
          <div class="space-pattern-info">
            <div class="space-pattern-context">{p.context}</div>
            <div class="space-pattern-values">{p.values}</div>
            <code class="space-pattern-tokens">{p.tokens}</code>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       DO / DON'T
  ════════════════════════════════════════════════════════ -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">Do & Don't</span>
      <span class="section-desc">Spacing best practices</span>
    </div>

    <div class="do-dont-grid">
      <div class="do-dont-card do-dont-card--dont">
        <div class="do-dont-header">Don't</div>
        <div class="do-dont-body">
          Mix hardcoded values like <code>padding: 12px</code> and <code>margin: 0.75rem</code> — inconsistent across components.
        </div>
      </div>
      <div class="do-dont-card do-dont-card--do">
        <div class="do-dont-header">Do</div>
        <div class="do-dont-body">
          Use tokens: <code>padding: var(--space-150)</code>, <code>margin: var(--space-200)</code> — consistent and themeable.
        </div>
      </div>
    </div>

    <div class="do-dont-grid">
      <div class="do-dont-card do-dont-card--dont">
        <div class="do-dont-header">Don't</div>
        <div class="do-dont-body">
          Use arbitrary values off the 4px grid (e.g. 7px, 13px, 19px) — breaks alignment.
        </div>
      </div>
      <div class="do-dont-card do-dont-card--do">
        <div class="do-dont-header">Do</div>
        <div class="do-dont-body">
          Use grid-aligned tokens (4, 8, 12, 16, 24, 32…) for new work. Pragmatic tokens only when matching existing patterns.
        </div>
      </div>
    </div>

    <div class="do-dont-grid">
      <div class="do-dont-card do-dont-card--dont">
        <div class="do-dont-header">Don't</div>
        <div class="do-dont-body">
          Use <code>gap: 0</code> when you mean "tight" — zero can feel cramped; consider <code>space-050</code> or <code>space-100</code>.
        </div>
      </div>
      <div class="do-dont-card do-dont-card--do">
        <div class="do-dont-header">Do</div>
        <div class="do-dont-body">
          Use semantic spacing even for compact layouts — <code>gap: var(--space-100)</code> gives predictable rhythm.
        </div>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       IMPLEMENTATION
  ════════════════════════════════════════════════════════ -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">Implementation</span>
      <span class="section-desc">Using tokens in code</span>
    </div>

    <AccordionSection title="CSS variables" open>
      <p>Use the CSS custom properties directly in your styles.</p>
      <pre><code>{cssExample}</code></pre>
    </AccordionSection>

    <AccordionSection title="SCSS">
      <p>If your project uses SCSS, you can alias the tokens or use them in mixins.</p>
      <pre><code>{scssExample}</code></pre>
    </AccordionSection>

    <AccordionSection title="Relationship to Grid">
      <p>
        Spacing tokens apply to <strong>component-level</strong> layout — padding inside cards, gaps in button groups, margins between sections.
        The <a href="/grid">Grid</a> page covers <strong>page-level</strong> layout — Bootstrap containers, rows, columns, and gutters (<code>g-*</code>, <code>gx-*</code>, <code>gy-*</code>).
      </p>
      <p>
        Use spacing tokens for micro layout inside grid columns. Use Bootstrap gutter utilities for gaps between columns.
      </p>
    </AccordionSection>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       PRAGMATIC TOKENS NOTE
  ════════════════════════════════════════════════════════ -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">Pragmatic Tokens</span>
      <span class="section-desc">6px and 10px — when and why</span>
    </div>

    <div class="info-box">
      <strong>space-075 (6px)</strong> and <strong>space-125 (10px)</strong> are not on the 4px grid. They are included because the product already uses these values (e.g. widget borders, bottom bar padding, compact layouts).
      <br /><br />
      <strong>Guidance:</strong> For new work, prefer grid-aligned tokens (4, 8, 12, 16, 24, 32…). Use 6px and 10px only when matching existing patterns or when a design explicitly requires a value between 4–8 or 8–12.
    </div>
  </div>

  <div class="footer">Nexus Design System · Spacing</div>
</Layout>
