---
interface Props {
  title: string;
  section: string;
}

import BrandPicker from '../components/BrandPicker.jsx';

const { title, section } = Astro.props;

const navGroups = [
  {
    label: 'Foundations',
    items: [
      { name: 'Colours',    href: '/colours',    id: 'colours',    icon: '◆' },
      { name: 'Typography', href: '/typography',  id: 'typography', icon: 'Aa' },
      { name: 'Spacing',    href: '/spacing',     id: 'spacing',    icon: '⊞' },
      { name: 'Grid',       href: '/grid',        id: 'grid',       icon: '▦' },
      { name: 'Iconography', href: '/iconography', id: 'iconography', icon: '◈' },
      { name: 'Theme',      href: '/theme',       id: 'theme',       icon: '◐' },
      { name: 'Tokens',     href: '/tokens',      id: 'tokens',      icon: '⊕' },
      { name: 'Shape & Surface', href: '/shape-surface',  id: 'shape-surface',  icon: '◇' },
      { name: 'Brand',  href: '/brand',  id: 'brand',  icon: '◆' },
    ],
  },
  {
    label: 'Components',
    items: [
      { name: 'Atoms', href: '/atoms', id: 'atoms', icon: '○', children: [
        { name: 'Accordion',      href: '/atoms/accordion',      id: 'atoms/accordion' },
        { name: 'Alert',           href: '/atoms/alert',           id: 'atoms/alert' },
        { name: 'AspectRatio',     href: '/atoms/aspectratio',     id: 'atoms/aspectratio' },
        { name: 'Avatar',          href: '/atoms/avatar',          id: 'atoms/avatar' },
        { name: 'Badge',           href: '/atoms/badge',           id: 'atoms/badge' },
        { name: 'Button',          href: '/atoms/button',          id: 'atoms/button' },
        { name: 'Calendar',        href: '/atoms/calendar',        id: 'atoms/calendar' },
        { name: 'Checkbox',        href: '/atoms/checkbox',        id: 'atoms/checkbox' },
        { name: 'Code',            href: '/atoms/code',            id: 'atoms/code' },
        { name: 'Divider',         href: '/atoms/divider',         id: 'atoms/divider' },
        { name: 'FormField',       href: '/atoms/formfield',       id: 'atoms/formfield' },
        { name: 'Heading',         href: '/atoms/heading',         id: 'atoms/heading' },
        { name: 'Icon',            href: '/atoms/icon',            id: 'atoms/icon' },
        { name: 'Image',           href: '/atoms/image',           id: 'atoms/image' },
        { name: 'Input',           href: '/atoms/input',           id: 'atoms/input' },
        { name: 'InputField',      href: '/atoms/inputfield',      id: 'atoms/inputfield' },
        { name: 'Label',           href: '/atoms/label',           id: 'atoms/label' },
        { name: 'Link',            href: '/atoms/link',            id: 'atoms/link' },
        { name: 'Menu',            href: '/atoms/menu',            id: 'atoms/menu' },
        { name: 'Overlay',         href: '/atoms/overlay',         id: 'atoms/overlay' },
        { name: 'Pagination',      href: '/atoms/pagination',      id: 'atoms/pagination' },
        { name: 'Popover',         href: '/atoms/popover',         id: 'atoms/popover' },
        { name: 'ProgressBar',     href: '/atoms/progressbar',     id: 'atoms/progressbar' },
        { name: 'RadioGroup',      href: '/atoms/radiogroup',      id: 'atoms/radiogroup' },
        { name: 'RatingStar',      href: '/atoms/ratingstar',      id: 'atoms/ratingstar' },
        { name: 'Select',          href: '/atoms/select',          id: 'atoms/select' },
        { name: 'Skeleton',        href: '/atoms/skeleton',        id: 'atoms/skeleton' },
        { name: 'Slider',          href: '/atoms/slider',          id: 'atoms/slider' },
        { name: 'Spinner',         href: '/atoms/spinner',         id: 'atoms/spinner' },
        { name: 'Steps',           href: '/atoms/steps',           id: 'atoms/steps' },
        { name: 'StoryProgress',   href: '/atoms/storyprogress',   id: 'atoms/storyprogress' },
        { name: 'Switch',          href: '/atoms/switch',          id: 'atoms/switch' },
        { name: 'Tabs',            href: '/atoms/tabs',            id: 'atoms/tabs' },
        { name: 'Tag',             href: '/atoms/tag',             id: 'atoms/tag' },
        { name: 'Text',            href: '/atoms/text',            id: 'atoms/text' },
        { name: 'Textarea',        href: '/atoms/textarea',        id: 'atoms/textarea' },
        { name: 'Thumbnail',       href: '/atoms/thumbnail',       id: 'atoms/thumbnail' },
        { name: 'Timeline',        href: '/atoms/timeline',        id: 'atoms/timeline' },
        { name: 'Timer',           href: '/atoms/timer',           id: 'atoms/timer' },
        { name: 'Toast',           href: '/atoms/toast',           id: 'atoms/toast' },
        { name: 'Toggle',          href: '/atoms/toggle',          id: 'atoms/toggle' },
        { name: 'ToggleGroup',     href: '/atoms/togglegroup',     id: 'atoms/togglegroup' },
        { name: 'Tooltip',         href: '/atoms/tooltip',         id: 'atoms/tooltip' },
        { name: 'Upload File',     href: '/atoms/fileinput',       id: 'atoms/fileinput' },
        { name: 'VisuallyHidden',  href: '/atoms/visuallyhidden',  id: 'atoms/visuallyhidden' },
      ]},
      { name: 'Molecules',  href: '/molecules',   id: 'molecules',  icon: '◎', children: [
        { name: 'Card',          href: '/molecules/card',           id: 'molecules/card' },
        { name: 'Breadcrumb',    href: '/molecules/breadcrumb',     id: 'molecules/breadcrumb' },
        { name: 'Confirm dialog',href: '/molecules/confirmdialog',  id: 'molecules/confirmdialog' },
        { name: 'Drawer',        href: '/molecules/drawer',         id: 'molecules/drawer' },
        { name: 'Dropzone',      href: '/molecules/dropzone',       id: 'molecules/dropzone' },
        { name: 'Empty state',   href: '/molecules/empty-state',    id: 'molecules/empty-state' },
        { name: 'List skeleton', href: '/molecules/list-skeleton',   id: 'molecules/list-skeleton' },
        { name: 'Modal',         href: '/molecules/modal',          id: 'molecules/modal' },
        { name: 'Menu',          href: '/molecules/menu',           id: 'molecules/menu' },
        { name: 'Rating',        href: '/molecules/rating',          id: 'molecules/rating' },
        { name: 'Search input',  href: '/molecules/searchinput',    id: 'molecules/searchinput' },
        { name: 'Table',         href: '/molecules/table',          id: 'molecules/table' },
      ]},
      { name: 'Organisms',  href: '/organisms',   id: 'organisms',  icon: '◉' },
    ],
  },
  {
    label: 'Reference',
    items: [
      { name: 'Reference Tokens', href: '/blade-tokens', id: 'blade-tokens', icon: '⊕' },
    ],
  },
];

const isAtomSection = section.startsWith('atoms');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} — Nexus Design System</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,600;1,300&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
  <div class="app">

    <!-- ─── SIDEBAR ─────────────────────────────────── -->
    <aside class="sidebar">
      <div class="sidebar-brand">
        <a href="/">
          <h1>Nexus</h1>
          <span>Design System</span>
        </a>
      </div>

      <nav>
        {navGroups.map((group) => (
          <div class="nav-group">
            <div class="nav-group-title">{group.label}</div>
            {group.items.map((item) => (
              <>
                <a
                  href={item.href}
                  class:list={['nav-link', { active: section === item.id }]}
                >
                  <span class="nav-icon">{item.icon}</span>
                  {item.name}
                </a>
                {item.children && (
                  ((item.id === 'atoms' && section.startsWith('atoms')) ||
                  (item.id === 'molecules' && section.startsWith('molecules'))) && (
                    <div class="nav-children">
                      {item.children.map((child) => (
                        <a
                          href={child.href}
                          class:list={['nav-link', 'nav-child-link', { active: section === child.id }]}
                        >
                          {child.name}
                        </a>
                      ))}
                    </div>
                  )
                )}
              </>
            ))}
          </div>
        ))}
      </nav>
    </aside>

    <!-- ─── MAIN CONTENT ────────────────────────────── -->
    <main class="main">
      <div class="page">
        <slot />
      </div>
    </main>

  </div>
  <BrandPicker client:load />
<script>
  const sidebar = document.querySelector('.sidebar');
  if (sidebar) {
    const key = 'nexus-sidebar-scroll';
    const saved = sessionStorage.getItem(key);
    if (saved) {
      sidebar.scrollTop = Number(saved);
    } else {
      const active = sidebar.querySelector('.nav-link.active, .nav-child-link.active');
      if (active) active.scrollIntoView({ block: 'center' });
    }
    window.addEventListener('beforeunload', () => {
      sessionStorage.setItem(key, String(sidebar.scrollTop));
    });
    document.querySelectorAll('.sidebar a[href]').forEach((a) => {
      a.addEventListener('click', () => {
        sessionStorage.setItem(key, String(sidebar.scrollTop));
      });
    });
  }
</script>
</body>
</html>

<style is:global>
  @import '../styles/base.css';
  @import '../styles/layout.css';
  @import '../styles/components.css';
  @import '../styles/tokens.scss';
</style>
